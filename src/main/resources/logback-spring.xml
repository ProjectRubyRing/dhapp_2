<?xml version="1.0" encoding="UTF-8"?>
<!--
    ログ出力構成。

    このアプリは WildFly(JBoss EAP) に WAR デプロイされるが、
    jboss-deployment-structure.xml で logging サブシステムを除外しているため、
    ログ出力はこの war 内の Logback（Spring Boot 標準バインディング）が担う。

    出力先はすべて環境変数 EFS_LOGS_PATH で指定したディレクトリ配下に集約する。
    （未設定時は /mnt/logs/front/logs/inter-api）

    ファイル名の先頭には、このホストの IPv4 アドレス（区切り文字をハイフンにしたもの）と
    "_" をプレフィックスとして付ける。例: 10.0.1.23 のホストなら 10-0-1-23_application.log

      ${EFS_LOGS_PATH}/<IP>_application.log   … 各 REST API 機能の処理内容を詳細に記録（アプリログ）
      ${EFS_LOGS_PATH}/<IP>_error.log        … ERROR レベルのみ。Java 例外スタックトレース形式で出力。
                                              CloudWatch Agent のマルチライン処理検証用。

    ローテーションはすべて 1 時間ごと（TimeBasedRollingPolicy）。ローテーション後のファイル名は
    出力中のファイル名の後ろに ".%d{yyyy-MM-dd-HH}" を付けたもの。
    例: 10-0-1-23_application.log → 10-0-1-23_application.log.2026-09-26-14
    maxHistory の単位はローテーション周期（＝1 時間）なので、336 で 14 日分を保持する。
-->
<configuration>

    <!-- 出力ルートディレクトリ（環境変数 EFS_LOGS_PATH）。未設定なら /mnt/logs/front/logs/inter-api -->
    <property name="EFS_LOGS_PATH" value="${EFS_LOGS_PATH:-/mnt/logs/front/logs/inter-api}"/>

    <!-- ファイル名プレフィックス用のホスト IPv4 アドレス（例: 10-0-1-23） -->
    <define name="HOST_IP" class="com.example.dhapp.logging.HostIpPropertyDefiner"/>

    <!--
        エラーログ（<IP>_<ランダム>.err）のファイル名に使うランダム文字列（[a-zA-Z0-9] 20 文字）。
        設定読み込み時（＝起動時）に 1 回だけ生成されるため、再起動ごとに別名のファイルになる。
    -->
    <define name="ERR_FILE_ID" class="com.example.dhapp.logging.RandomStringPropertyDefiner">
        <length>20</length>
    </define>

    <!--
        asyncdriver_<ランダム>.err のファイル名に使うランダム数字（[0-9] 17 桁）。
        ERR_FILE_ID と同様、起動時に 1 回だけ生成される。
    -->
    <define name="ASYNCDRIVER_ERR_FILE_ID" class="com.example.dhapp.logging.RandomStringPropertyDefiner">
        <length>17</length>
        <characters>0123456789</characters>
    </define>

    <!-- アプリログ用パターン（詳細・requestId 追跡しやすい形式） -->
    <property name="APP_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n%ex"/>

    <!-- ===== コンソール（開発・コンテナ標準出力用） ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== アプリログ: EFS_LOGS_PATH/<IP>_application.log ===== -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_application.log.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== エラーログ: EFS_LOGS_PATH/<IP>_error.log =====
        ERROR レベルのみを通す。例外は %ex により標準の Java スタックトレース形式で
        （"Caused by:" / "... N more" を含めて）複数行に展開される。
        各エントリは必ず先頭がタイムスタンプで始まるため、CloudWatch Agent 側で
        multi_line_start_pattern に "^\d{4}-\d{2}-\d{2}" を指定すれば
        スタックトレース全体を 1 イベントとして扱えることを確認できる。
    -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_error.log.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== 各 REST アプリの処理内容ログ（複数ファイル・同一内容） =====
        各 REST API（demo / db / cache / external）が処理した内容（リクエスト・処理ステップ・
        レスポンス・処理時間）を、以下の各ファイルへ「全て同じ内容」で必ず出力する。
        いずれも application.log と同じ APP_PATTERN・DEBUG まで詳細に記録する。
        （ファイル名の先頭には <IP>_ が付く）

          keax0003.log      keax0010.log     <ランダム>.err   accesslog
          tracelog          dbiolog          dbiolog_dao      inputmsglog
          outputmsglog      asyncdriver.log  authlog          connectinlog
          connectoutlog     mrdlog           asyncdriver_<ランダム数字>.err

        <ランダム>.err の <ランダム> 部分は ERR_FILE_ID（起動ごとに生成する英数字 20 文字）。
        asyncdriver_<ランダム数字>.err の <ランダム数字> 部分は ASYNCDRIVER_ERR_FILE_ID
        （起動ごとに生成する数字 17 桁）。
    -->
    <appender name="KEAX_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_keax0003.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_keax0003.log.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="KEAX0010_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_keax0010.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_keax0010.log.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_${ERR_FILE_ID}.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_${ERR_FILE_ID}.err.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_accesslog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_accesslog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_tracelog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_tracelog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DBIO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_dbiolog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_dbiolog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DBIO_DAO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_dbiolog_dao</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_dbiolog_dao.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="INPUTMSG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_inputmsglog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_inputmsglog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="OUTPUTMSG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_outputmsglog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_outputmsglog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNCDRIVER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_asyncdriver.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_asyncdriver.log.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUTH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_authlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_authlog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="CONNECTIN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_connectinlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_connectinlog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="CONNECTOUT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_connectoutlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_connectoutlog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="MRD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_mrdlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_mrdlog.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        asyncdriver_<ランダム数字>.err … <ランダム数字> は ASYNCDRIVER_ERR_FILE_ID（数字 17 桁）。
        例: 10-0-1-23_asyncdriver_48213907561234098.err
    -->
    <appender name="ASYNCDRIVER_ERR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EFS_LOGS_PATH}/${HOST_IP}_asyncdriver_${ASYNCDRIVER_ERR_FILE_ID}.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EFS_LOGS_PATH}/${HOST_IP}_asyncdriver_${ASYNCDRIVER_ERR_FILE_ID}.err.%d{yyyy-MM-dd-HH}</fileNamePattern>
            <maxHistory>336</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        アプリ本体（各 REST API 機能）は DEBUG まで詳細に出力する。
        application.log に加え、上記すべてのファイルへ同じ処理内容を必ず出力する。
        additivity=true のまま root にも伝播させ、コンソールと error.log（ERROR のみ）にも載せる。
    -->
    <logger name="com.example.dhapp" level="DEBUG">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="KEAX_FILE"/>
        <appender-ref ref="KEAX0010_FILE"/>
        <appender-ref ref="ERR_FILE"/>
        <appender-ref ref="ACCESS_FILE"/>
        <appender-ref ref="TRACE_FILE"/>
        <appender-ref ref="DBIO_FILE"/>
        <appender-ref ref="DBIO_DAO_FILE"/>
        <appender-ref ref="INPUTMSG_FILE"/>
        <appender-ref ref="OUTPUTMSG_FILE"/>
        <appender-ref ref="ASYNCDRIVER_FILE"/>
        <appender-ref ref="AUTH_FILE"/>
        <appender-ref ref="CONNECTIN_FILE"/>
        <appender-ref ref="CONNECTOUT_FILE"/>
        <appender-ref ref="MRD_FILE"/>
        <appender-ref ref="ASYNCDRIVER_ERR_FILE"/>
    </logger>

    <!-- JTA/トランザクションの詳細を追いたい場合に有効化しやすいよう明示しておく -->
    <logger name="org.springframework.transaction" level="INFO"/>
    <logger name="org.springframework.jdbc.core" level="INFO"/>

    <!-- root: コンソール・エラーログ（ERROR のみ） -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
