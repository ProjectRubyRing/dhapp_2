<?xml version="1.0" encoding="UTF-8"?>
<!--
    ログ出力構成。

    このアプリは WildFly(JBoss EAP) に WAR デプロイされるが、
    jboss-deployment-structure.xml で logging サブシステムを除外しているため、
    ログ出力はこの war 内の Logback（Spring Boot 標準バインディング）が担う。

    出力先はすべて環境変数 LOG_OUT_DIR で指定したディレクトリ配下に集約する。
    （未設定時は /mnt/logs/front/logs/inter-api）

      ${LOG_OUT_DIR}/application.log   … 各 REST API 機能の処理内容を詳細に記録（アプリログ）
      ${LOG_OUT_DIR}/error.log        … ERROR レベルのみ。Java 例外スタックトレース形式で出力。
                                         CloudWatch Agent のマルチライン処理検証用。
      ${LOG_OUT_DIR}/mid/server.log   … JBoss EAP のサーバログ相当。EAP 既定フォーマットで
                                         フレームワーク／アプリを含む全ログを記録する。
-->
<configuration>

    <!-- 出力ルートディレクトリ（環境変数 LOG_OUT_DIR）。未設定なら /mnt/logs/front/logs/inter-api -->
    <property name="LOG_OUT_DIR" value="${LOG_OUT_DIR:-/mnt/logs/front/logs/inter-api}"/>

    <!-- アプリログ用パターン（詳細・requestId 追跡しやすい形式） -->
    <property name="APP_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n%ex"/>

    <!--
        JBoss EAP standalone の server.log 既定パターンに合わせる。
        EAP:  %d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c] (%t) %s%e%n
        （ミリ秒がカンマ区切り、レベル・カテゴリ・スレッド・メッセージ・例外）

        注意: Logback の %d{...} はカンマをオプション区切り（第2引数=タイムゾーンID）と
        解釈するため、日付パターン自体にカンマを含める場合は全体をダブルクォートで囲む。
        囲まないと Logback 1.5 系では ZoneRulesException: Unknown time-zone ID: SSS で
        初期化に失敗する。
    -->
    <property name="SERVER_PATTERN"
              value='%d{"yyyy-MM-dd HH:mm:ss,SSS"} %-5level [%logger] (%thread) %msg%n%ex'/>

    <!-- ===== コンソール（開発・コンテナ標準出力用） ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== アプリログ: LOG_OUT_DIR/application.log ===== -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== エラーログ: LOG_OUT_DIR/error.log =====
        ERROR レベルのみを通す。例外は %ex により標準の Java スタックトレース形式で
        （"Caused by:" / "... N more" を含めて）複数行に展開される。
        各エントリは必ず先頭がタイムスタンプで始まるため、CloudWatch Agent 側で
        multi_line_start_pattern に "^\d{4}-\d{2}-\d{2}" を指定すれば
        スタックトレース全体を 1 イベントとして扱えることを確認できる。
    -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== サーバログ: LOG_OUT_DIR/mid/server.log =====
        JBoss EAP のサーバログ相当を EAP 既定フォーマットで出力する。
        root に接続し、Spring/WildFly 由来を含む全カテゴリのログを収集する。
    -->
    <appender name="SERVER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/mid/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/mid/server.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${SERVER_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== 各 REST アプリの処理内容ログ（複数ファイル・同一内容） =====
        各 REST API（demo / db / cache / external）が処理した内容（リクエスト・処理ステップ・
        レスポンス・処理時間）を、以下の各ファイルへ「全て同じ内容」で必ず出力する。
        いずれも application.log と同じ APP_PATTERN・DEBUG まで詳細に記録する。

          keax0003.log      xxxxxxxxxx.err   accesslog        tracelog
          dbiolog           inputmsglog      outputmsglog     asyncdriver.log
          authlog           connectinlog     connectoutlog    asyncdriver_xxxxx.err
    -->
    <appender name="KEAX_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/keax0003.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/keax0003.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/xxxxxxxxxx.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/xxxxxxxxxx.%d{yyyy-MM-dd}.%i.err</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/accesslog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/accesslog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/tracelog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/tracelog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="DBIO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/dbiolog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/dbiolog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="INPUTMSG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/inputmsglog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/inputmsglog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="OUTPUTMSG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/outputmsglog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/outputmsglog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNCDRIVER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/asyncdriver.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/asyncdriver.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUTH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/authlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/authlog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="CONNECTIN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/connectinlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/connectinlog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="CONNECTOUT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/connectoutlog</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/connectoutlog.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        asyncdriver_xxxxx.err … xxxxxxxxxx.err と同様、拡張子 .err の固定ファイル名で出力する。
        （xxxxx 部分はファイル名の一部としてそのまま扱う）
    -->
    <appender name="ASYNCDRIVER_ERR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/asyncdriver_xxxxx.err</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/asyncdriver_xxxxx.%d{yyyy-MM-dd}.%i.err</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        ===== mid ディレクトリ配下に出力するログ: LOG_OUT_DIR/mid/gc.log =====
        server.log（上で定義済み）と同様、mid ディレクトリを挟んで出力する。
        内容は他ファイルと同じ処理内容。mid ディレクトリは自動作成される。
    -->
    <appender name="GC_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_OUT_DIR}/mid/gc.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_OUT_DIR}/mid/gc.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${APP_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        アプリ本体（各 REST API 機能）は DEBUG まで詳細に出力する。
        application.log に加え、上記すべてのファイルへ同じ処理内容を必ず出力する。
        additivity=true のまま root にも伝播させ、server.log（全体）と error.log（ERROR のみ）にも載せる。
    -->
    <logger name="com.example.dhapp" level="DEBUG">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="KEAX_FILE"/>
        <appender-ref ref="ERR_FILE"/>
        <appender-ref ref="ACCESS_FILE"/>
        <appender-ref ref="TRACE_FILE"/>
        <appender-ref ref="DBIO_FILE"/>
        <appender-ref ref="INPUTMSG_FILE"/>
        <appender-ref ref="OUTPUTMSG_FILE"/>
        <appender-ref ref="ASYNCDRIVER_FILE"/>
        <appender-ref ref="AUTH_FILE"/>
        <appender-ref ref="CONNECTIN_FILE"/>
        <appender-ref ref="CONNECTOUT_FILE"/>
        <appender-ref ref="ASYNCDRIVER_ERR_FILE"/>
        <appender-ref ref="GC_FILE"/>
    </logger>

    <!-- JTA/トランザクションの詳細を追いたい場合に有効化しやすいよう明示しておく -->
    <logger name="org.springframework.transaction" level="INFO"/>
    <logger name="org.springframework.jdbc.core" level="INFO"/>

    <!-- root: コンソール・サーバログ（EAP 形式・全体）・エラーログ（ERROR のみ） -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SERVER_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
